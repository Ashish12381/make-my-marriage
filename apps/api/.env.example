# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Optional during scaffolding. No connection is attempted when blank.
MONGODB_URI=

# Integrations validate these values only when their configuration is requested.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

GOOGLE_PLACES_API_KEY=
CRON_SECRET=

# Required for authentication. Generate a random value of at least 32 characters.
AUTH_SECRET=
# Session lifetime; production HTTPS cookies are always Secure.
SESSION_DAYS=7

# Set to 1 only behind one trusted proxy that normalizes client IP headers.
AUTH_TRUST_PROXY_HOPS=0
